    {
      "id": "claim_c7869c5bc67f4bb4a0df0fcab4dc80ea",
      "statement": "The cardmarket instance defines four discrete browser states via the StateId type ('start' | 'results' | 'detail' | 'versions'). State is derived purely from the current URL via stateFromUrl in src/lib/state.ts, which maps URL patterns to state IDs. This makes state a pure function of the URL, observable even when domain assertions have failed.",
      "evidence": [
        {
          "resource": "repo://skills/cardmarket-automation/src/lib/state.ts#L4-L12",
