          "version": "repo-lines-v1:sha256:ddc24eec02775be747c9201a5d978107dcb26fc818a64b4aaabab153ee77e3cd:"
        }
      ]
    },
    {
      "id": "claim_9c3d0756e71743808545cd6d2d7bf305",
      "statement": "Browser observations (the fixed read-only DOM projection browser.status / browser.inspect / browser.inspectRegion / browser.screenshot from observation.ts) and element attributes are obtained through the same pinned-CLI run-code path against the user's live page; the runtime never executes raw caller-supplied JavaScript or selectors, and a site can only extend observation via the ObservationSite interface.",
      "evidence": [
        {
          "resource": "repo://skills/cardmarket-automation/node_modules/playwright-core/lib/tools/skills/playwright-cli/references/element-attributes.md",
          "version": "repo-file-v1:sha256:bf19aa4671e0a50a0fefa9c790f39124e803060eefe395042b723c29fcb7faa2"
