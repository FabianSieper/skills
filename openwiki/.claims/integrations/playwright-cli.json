    {
      "id": "claim_647a08ef6a314b559035a67b0e419b2e",
      "statement": "Named-session reuse: ensureAttached() parses CLI list --json output (parseSessions expects a { browsers: [...] } array), locates the named session config.browser.session, and reuses it without attaching when it is compatible — status === \"open\", attached === true, compatible === true, and in extension mode browserType === target.",
      "evidence": [
        {
