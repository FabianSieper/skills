    {
      "id": "claim_bcf3a86957ff45cca35233ae4e57b229",
      "statement": "The run-code result envelope is strictly validated after decoding: value.ok must be true (a false envelope with a known error code maps to the matching ErrorCode), value.accountKey must be a non-empty string, and the serialized result must not exceed maxOutputBytes; any violation throws CLI_PROTOCOL (run-code-output), so the integration fails closed on protocol drift.",
      "evidence": [
        {
          "resource": "repo://skills/website-automation-builder/assets/site-template/src/runtime/cli-browser.ts#L212-L238",
          "version": "repo-lines-v1:sha256:f56c582e89ffbb4c3c76b28cfe6443f26b11c29e9052031f892f2ed4d09a4b0e:"
        }
