  "claims": [
    {
      "id": "claim_8fbbe96b77ee466484c12eea88eb6af5",
      "statement": "The /setup skill follows an audit-then-install contract: run a read-only audit first, install only the items the audit reports as missing or incompatible, in dependency order, then re-audit to confirm all required findings are ok, and finally report installed versions, blocked items, and whether tests ran.",
      "evidence": [
        {
          "resource": "repo://.agents/skills/setup/SKILL.md#L11-L68",
          "version": "repo-lines-v1:sha256:95b0c921ebe004e51993a0f5ae2de9f8a33c74a926324b84e2a4bf97116da608:"
        }
      ]
    },
    {
      "id": "claim_3dc1008cd3f5409cb3d80b430d66b938",
      "statement": "The setup contract contains hard prohibitions: it must never automatically run openwiki --init, any OpenWiki authentication/integration command, playwright-cli attach, or browser/extension installation, and it must never launch, replace, restart, or close a browser; network access, global npm installs, package-manager changes, and writes outside the checkout are approval-bearing, and setup preserves dirty worktrees while not rewriting manifests, lockfiles, generated skills, or user changes.",
      "evidence": [
        {
          "resource": "repo://.agents/skills/setup/SKILL.md#L11-L25",
          "version": "repo-lines-v1:sha256:1431fd81b532b9cabc5d6ecbd11ceb4193eacb8a3171759ae70dd941454fdbe9:"
        }
      ]
    },
    {
      "id": "claim_b1b1cbb8274c46429e18df7427857500",
      "statement": "The read-only audit script check.mjs locates the repository root (by Taskfile.yml, README.md, skills/website-automation-builder, and skills/cardmarket-automation/package.json), emits one finding per prerequisite with a status (ok, missing, incompatible, blocked, unknown, not-configured), a required flag, expected and found values, and a suggested fix; the report is ok when every required finding is ok, and the process exits 1 otherwise (2 if no root is found), with a --json flag for structured output.",
      "evidence": [
        {
          "resource": "repo://.agents/skills/setup/scripts/check.mjs#L261-L384",
          "version": "repo-lines-v1:sha256:80ce1d41673552479d4de34beb65987fc28542c04cbcc2125a2f76965517046e:"
