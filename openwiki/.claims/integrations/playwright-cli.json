  "claims": [
    {
      "id": "claim_d244120315b14d4a8cdf1a15cee8f55a",
      "statement": "The Playwright CLI (playwright-cli) is the only browser transport for generated site runtimes; it is a user-scoped global command on PATH, pinned to version 0.1.19, and the runtime never talks to Playwright directly, shells out to a browser binary, a shell, or a runtime compiler.",
      "evidence": [
        {
          "resource": "repo://artifacts/demo-automation/site.config.ts#L18-L24",
          "version": "repo-lines-v1:sha256:b894e25e849495f9bf9427a543b18d55c681daef613021b393fe2386584f42b2:"
        },
        {
          "resource": "repo://skills/cardmarket-automation/node_modules/playwright-core/lib/tools/skills/playwright-cli/SKILL.md",
          "version": "repo-file-v1:sha256:1a609c93bff3eea9ab99fed93c0334c851fdc39fb6ac5335551bfb87c171d57c"
        },
        {
          "resource": "repo://skills/website-automation-builder/assets/site-template/src/runtime/cli-browser.ts#L82-L130",
          "version": "repo-lines-v1:sha256:c42319d85aab47a95b01861338a18791542ba0a6e1b06cc6ab4e9d7ff7e0f022:"
        }
      ]
    },
    {
      "id": "claim_52f482ea83aa48e0836b37434a422982",
      "statement": "The runtime treats the pinned Playwright CLI version 0.1.19 as an invariant: CliBrowser.ensureAttached() requires the --version output to exactly equal config.browser.cliVersion (\"0.1.19\") and throws CLI_PROTOCOL (playwright-cli-version) on any mismatch, failing closed with no semver range and no silent auto-upgrade.",
      "evidence": [
        {
          "resource": "repo://artifacts/demo-automation/site.config.ts#L23-L23",
          "version": "repo-lines-v1:sha256:0919e83af9e525573715e5fc2ca01c1b1e396e5d4b2003ef27a570b5ed9ff048:"
        },
        {
