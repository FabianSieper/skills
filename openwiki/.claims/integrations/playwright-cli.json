          "version": "repo-lines-v1:sha256:0209c310b859362cf892da18523fc0c3cddfdb949a73a76ff7bacc95e04e7738:"
        }
      ]
    },
    {
      "id": "claim_3c6a594d5e17428e9209fdaaf490f79c",
      "statement": "The attach-only invariant holds at every branch of CliBrowser.ensureAttached(): the runtime never launches, replaces, or closes a browser, and a missing or non-attaching browser is a hard user-action error (BROWSER_REQUIRED / ATTACH_FAILED), never a fallback to open/launch/headless/profile/close.",
      "evidence": [
        {
          "resource": "repo://artifacts/demo-automation/site.config.ts#L18-L23",
          "version": "repo-lines-v1:sha256:0626173ab7948835b8bd649bd35ce0e7b86815cc40776bc1c358bc53a2f85284:"
