    {
      "id": "claim_f2904a29bdc94253bbbda5d06504dc47",
      "statement": "playwright-cli scopes session state (including storage state such as cookies and localStorage) to its working directory; the runtime always invokes the CLI with cwd set to the skill root (this.project) so it deterministically lands in the same session namespace, and the CLI session name must equal the project config.name.",
      "evidence": [
        {
          "resource": "repo://skills/website-automation-builder/assets/site-template/src/runtime/cli-browser.ts#L96-L106",
          "version": "repo-lines-v1:sha256:69ece444b44e1cff1088c28835e02c2f1ca5076a20a436b17f5f23408a01e1dd:"
