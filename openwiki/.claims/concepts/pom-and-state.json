    {
      "id": "claim_16a87ad6c0ea4484aa30fab39192d92f",
      "statement": "CardDetailPage is the richest POM in the cardmarket instance. It encapsulates reading (extractInfo, extractSellers, readUserOffers, readUserStockOffer), writing (openUserOfferEditForm, readUserOfferEditForm, closeUserOfferEditForm, applyUserOfferChanges, submitUserOfferEditForm, prepareUserOfferUpdate, executeUserOfferUpdate), and filtering (applySellerFilters, submitSellerFilters, settleSellerList) methods. All are in-page transitions that keep the agent in the detail state.",
      "evidence": [
        {
          "resource": "repo://skills/cardmarket-automation/src/pages/CardDetailPage.ts#L68-L501",
          "version": "repo-lines-v1:sha256:c368477eec04ddc7a2db572605d8e9e34151760bbeedf7550949731751c11e4b:"
        }
      ]
    },
    {
      "id": "claim_9a88520ce6bf4f15943fab34ef35a111",
      "statement": "The prepare/execute write-safety pattern in CardDetailPage captures a Preview (form state snapshot) at plan time and verifies at execute time that the form has not changed (sameFormState). If the state has drifted, it throws PLAN_CHANGED. Postconditions verify that the business effect (price, quantity, condition, language) was applied correctly, throwing POSTCONDITION_FAILED on mismatch.",
      "evidence": [
        {
          "resource": "repo://skills/cardmarket-automation/src/pages/CardDetailPage.ts#L468-L501",
          "version": "repo-lines-v1:sha256:23852b60d4faf4e96f7355ba948e5ea699993c737f9582d05ac8b39d3e8ee740:"
        }
