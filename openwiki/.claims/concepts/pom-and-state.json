    {
      "id": "claim_bdecc161d3e044d4b5cd53f0712d4665",
      "statement": "The builder's pom-and-selectors.md contract establishes a strict selector policy: a priority ordering for locators (data attributes to getByRole/getByLabel to business ID in unique container to stable short attribute), mandatory uniqueness checks via uniqueVisible/clickUnique/fillUnique (count must be exactly one), and prohibited patterns (no first/last/nth, no long XPath, no generated classes, no force:true, no coordinate clicks, no arbitrary sleeps). A missing target is UI_DRIFT; multiple matches are AMBIGUOUS_SELECTOR.",
      "evidence": [
        {
          "resource": "repo://skills/cardmarket-automation/src/runtime/guards.ts#L6-L32",
          "version": "repo-lines-v1:sha256:7edbb33acabf111d6100dce32ff195a4696f36fe4f6456dc5f7a284a5f71289b:"
